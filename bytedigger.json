{
  "validation_model": "opus",
  "agent_model": "sonnet",
  "exploration_model": "haiku",
  "satisfaction_thresholds": {
    "SIMPLE": 80,
    "FEATURE": 85,
    "COMPLEX": 90
  },
  "reviewers": {
    "mode": "auto"
  },
  "gates_enabled": true,
  "gate_backend": "bash",
  "tdd_mandatory": true,
  "worktree_auto": true,
  "constitution_path": "./constitution.md",
  "omitProjectContext": false,
  "logging": false,
  "learning": {
    "backend": "file",
    "max_inject": 10,
    "max_stored": 200,
    "storage_path": ".bytedigger/learnings"
  },
  "observability": {
    "enabled": true
  },
  "activeWorkInjection": true
}
