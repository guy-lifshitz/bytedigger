#!/usr/bin/env bash
# readiness — thin wrapper around bytedigger_engine.readiness (bd#117).
# Usage: readiness check --stage {start|review|ship} [--spec <path>] [--repo .] [--json]
#        readiness post --spec <path> [--repo .]
# Exit: 0 off/approved/done · 2 usage · 3 not approved · 4 unavailable · other = crash.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$HERE/../engine_py${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m bytedigger_engine.readiness "$@"
